# ==============================================================================
# ORBIT AI — Local Development Environment Configuration
# ==============================================================================

# Node.js Express Backend
PORT=5000
NODE_ENV=development

# SQLite Database Location (defaults to backend/data/orbit_ai.db if unset)
DB_PATH=backend/data/orbit_ai.db

# Internal Python FastAPI AI Microservice URL
AI_SERVICE_URL=http://localhost:8000

# AI Provider Selection: 'demo' (zero-GPU extractive mode) or 'ollama' (local LLM)
AI_PROVIDER=demo

# Ollama Local LLM Configuration (Active only when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Python AI Service Port
AI_SERVICE_PORT=8000
